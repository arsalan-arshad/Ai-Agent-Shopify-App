{
  "name": "shopify-ai-forecast-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "AI-agent powered inventory & demand forecasting app for Shopify merchants.",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.19.3",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-remix": "^6.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@shopify/cli": "^3.75.0",
    "@vitejs/plugin-react": "^4.2.0",
    "prisma": "^6.19.3",
    "typescript": "^5.3.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "allowScripts": {
    "@google/genai@2.24.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.27.4": true,
    "esbuild@0.17.6": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true
  }
}
