# Copy to .env and fill in real values. Never commit .env.

# From your Partner Dashboard app (Partners > Apps > this app > Client credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The app's public HTTPS URL. In dev, `shopify app dev` sets this to a
# temporary tunnel URL automatically. In production, this is your real
# hosting URL (Fly.io / Render / Railway / etc).
SHOPIFY_APP_URL=

# Comma-separated, must match [access_scopes] in shopify.app.toml.
SCOPES=read_orders,read_products,read_inventory,read_locations

# PostgreSQL connection string (the app only supports Postgres).
# Local dev with Postgres.app: postgresql://YOUR_MAC_USERNAME@localhost:5432/forecast
# Production: your host's managed Postgres URL. Never use production locally.
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/forecast

# 32-byte key, base64-encoded, used to encrypt merchants' own Gemini/Claude
# API keys at rest (app/lib/crypto.server.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this makes every previously stored merchant key
# undecryptable — they'd need to re-enter it in Settings.
ENCRYPTION_KEY=

NODE_ENV=development

# NOT used by this app — merchants add their own Gemini or Claude key from
# the in-app Settings page (app/routes/app.settings.jsx), encrypted per
# shop. There is no shared/fallback server-side AI key.
